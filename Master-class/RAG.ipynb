    "# 8. Test Agentic RAG\n",
    "# =========================================================\n",
    "def run_agentic_rag(question: str):\n",
    "    \"\"\"Helper function to run the LangGraph agent.\"\"\"\n",
    "    result = agentic_rag_graph.invoke({\n",
    "        \"question\": question,\n",
    "        \"route\": \"\",\n",
    "        \"context\": \"\",\n",
    "        \"answer\": \"\"\n",
